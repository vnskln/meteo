# Text files: LF in the repository and in the working tree
# (scripts and YAML run on Linux in CI and on the server)
* text=auto eol=lf

# Windows scripts need CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: no line-ending conversion, no text diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.jar binary
*.zip binary
*.woff binary
*.woff2 binary
