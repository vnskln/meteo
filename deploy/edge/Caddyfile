zai-meteo.pl {
	import /etc/caddy/headers.caddy

	handle /api/* {
		reverse_proxy meteo-prod-backend:8080
	}

	handle {
		reverse_proxy meteo-prod-frontend:80
	}
}

staging.zai-meteo.pl {
	import /etc/caddy/headers.caddy

	handle /api/* {
		reverse_proxy meteo-staging-backend:8080
	}

	handle {
		reverse_proxy meteo-staging-frontend:80
	}
}
